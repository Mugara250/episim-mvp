# Copy to .env (make setup does this). Never commit .env.
DATABASE_URL=sqlite:///./episim.db
# Change for any shared deployment. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=480
# Shows the "Demo" ribbon on every page and labels sample data.
DEMO_MODE=true
# Background simulation workers
WORKER_THREADS=2
# Where generated PDFs are written
FILES_DIR=./var/files
